        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"terminal\" and r._field == \"uptime_seconds\")\n  |> filter(fn: (r) => contains(value: r.terminal, set: ${terminal:json}))\n  |> group(columns: [\"terminal\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Kiosk-Seite",
      "description": "Lebenszeichen der Kiosk-Seite beim Agenten.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.terminal}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "läuft",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "hängt / fehlt",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"terminal\" and r._field == \"ui_alive\")\n  |> filter(fn: (r) => contains(value: r.terminal, set: ${terminal:json}))\n  |> toInt()\n  |> group(columns: [\"terminal\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false)"
        }
      ]
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Terminal offline",
      "description": "Die Kiosk-App hält den Server für nicht erreichbar.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
