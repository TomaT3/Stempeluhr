          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"terminal\" and r._field == \"pending\")\n  |> filter(fn: (r) => contains(value: r.terminal, set: ${terminal:json}))\n  |> group(columns: [\"terminal\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Laufzeit seit Boot",
      "description": "Fällt die Kurve auf 0, wurde der Pi neu gestartet.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "displayName": "${__field.labels.terminal}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
