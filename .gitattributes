# Shell-Skripte immer mit LF auschecken - CRLF (Windows) bricht bash auf
# Linux (z. B. per scp übertragene Deploy-Skripte): 'set: pipefail: invalid
# option name' und Befehle mit angehängtem \r.
*.sh text eol=lf

# Agent-Python-Dateien ebenfalls LF (werden per scp/ZIP auf die Pis gespielt).
*.py text eol=lf

# systemd-Units des Agenten (landen unverändert auf den Pis).
*.service text eol=lf
*.timer text eol=lf
